# Copy the backend block to backend/.env and the frontend block to frontend/.env.local.
# Placeholders only. Never put real secrets in this file.

# ---------------- backend/.env ----------------
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://nexvra:<db-password>@localhost:5432/nexvra_hrms
# Server default; the company time zone can be set in Settings.
TIME_ZONE=UTC
FRONTEND_URL=http://localhost:3000
# Private file storage (documents, photos). Must not be publicly served.
# PRIVATE_MEDIA_ROOT=/var/lib/nexvra-hrms/private_media

# Optional
# DJANGO_ADMIN_ENABLED=False
# CORS_ALLOWED_ORIGINS=          # only for split-domain deployments
# TRUST_X_FORWARDED_FOR=False    # True only behind a trusted reverse proxy
# THROTTLE_LOGIN=10/min
# THROTTLE_PASSWORD_RESET=5/hour
# SESSION_COOKIE_AGE=28800
# PASSWORD_RESET_TIMEOUT=86400
# LOG_LEVEL=INFO
# CACHE_URL=redis://127.0.0.1:6379/1   # shared cache for throttling with multiple workers
# SECURE_HSTS_PRELOAD=False

# Email (console backend in development)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=hrms@example.com

# Demo data (development only): password for `manage.py seed_demo`
# DEMO_USER_PASSWORD=

# ---------------- frontend/.env.local ----------------
# Where Next.js proxies /api/* (server-side only, never exposed to the browser)
BACKEND_URL=http://127.0.0.1:8000

# ---------------- tests/e2e ----------------
# E2E_BASE_URL=http://127.0.0.1:8000
# E2E_PASSWORD=                  # same as DEMO_USER_PASSWORD
