# Copy the backend block to backend/.env and the frontend block to frontend/.env.local.
# Placeholders only. Never put real secrets in this file.

# ---------------- backend/.env ----------------
# development | staging | production. staging/production refuse unsafe settings at start-up.
# Production values: deploy/env/backend.env.production.example and docs/deployment.md.
DJANGO_ENV=development
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://nexvra:<db-password>@localhost:5432/nexvra_hrms
# Server default; the company time zone can be set in Settings.
TIME_ZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:3000
# Private file storage (documents, photos). Must not be publicly served.
# PRIVATE_MEDIA_ROOT=/var/lib/nexvra-hrms/private_media

# Optional
# DJANGO_ADMIN_ENABLED=False
# CORS_ALLOWED_ORIGINS=          # only for split-domain deployments
# TRUST_X_FORWARDED_FOR=False    # True only behind a trusted reverse proxy
# THROTTLE_LOGIN=10/min
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_HEARTBEAT=30/min        # activity reports per user
# LOG_FILE=                        # e.g. /var/log/nexvra-hrms/backend.log (rotated)
# SESSION_COOKIE_AGE=28800
# PASSWORD_RESET_TIMEOUT=86400
# LOG_LEVEL=INFO
# CACHE_URL=redis://127.0.0.1:6379/1   # shared cache for throttling with multiple workers
# SECURE_HSTS_PRELOAD=False

# Email (console backend in development)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True              # port 587 (STARTTLS) ...
# EMAIL_USE_SSL=False             # ... or port 465 (SSL) - never both
# EMAIL_TIMEOUT=15
# DEFAULT_FROM_EMAIL=hrms@example.com
# Test with: python manage.py send_test_email --to you@example.com

# Backups (python manage.py backup_hrms / restore_hrms; see docs/backup.md)
# BACKUP_DIR=../backups           # outside any web-served folder
# BACKUP_RETENTION_DAYS=14
# BACKUP_COPY_DIR=                # optional verified second copy (network share / synced folder)
# PG_BIN_DIR=                     # folder with pg_dump/pg_restore if not on PATH

# Demo data (development only): password for `manage.py seed_demo`
# DEMO_USER_PASSWORD=

# ---------------- frontend/.env.local ----------------
# Where Next.js proxies /api/* (server-side only, never exposed to the browser)
BACKEND_URL=http://127.0.0.1:8000

# ---------------- tests/e2e ----------------
# E2E_BASE_URL=http://127.0.0.1:8000
# E2E_PASSWORD=                  # same as DEMO_USER_PASSWORD
