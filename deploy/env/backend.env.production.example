# Nexvra HRMS backend - PRODUCTION environment (copy to /etc/nexvra-hrms/backend.env, chmod 600).
# Placeholders only: <...> values must be replaced on the server. Never commit the real file.

DJANGO_ENV=production
DJANGO_DEBUG=False
# Generate once:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<64+ random characters>
DJANGO_ALLOWED_HOSTS=<hrms.your-domain.com>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<hrms.your-domain.com>
FRONTEND_URL=https://<hrms.your-domain.com>

# PostgreSQL 16 (database and role created as in docs/deployment.md)
DATABASE_URL=postgres://nexvra:<db-password>@127.0.0.1:5432/nexvra_hrms
TIME_ZONE=Asia/Kolkata

# Files and backups (outside any web-served directory)
PRIVATE_MEDIA_ROOT=/var/lib/nexvra-hrms/private_media
BACKUP_DIR=/var/backups/nexvra-hrms
BACKUP_RETENTION_DAYS=14
# Optional second copy (mounted network share / synced folder), verified by checksum:
# BACKUP_COPY_DIR=/mnt/offsite/nexvra-hrms

# Behind nginx on the same host
TRUST_X_FORWARDED_FOR=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=True     # only once you are sure the domain will stay HTTPS-only

# Email (SMTP). Use an app password / SMTP credential, never a personal password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp.your-provider.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Nexvra HRMS <hrms@<your-domain.com>>

# Logging and throttling
LOG_LEVEL=INFO
LOG_FILE=/var/log/nexvra-hrms/backend.log
# Shared cache so login throttling works across gunicorn workers:
# CACHE_URL=redis://127.0.0.1:6379/1
DJANGO_ADMIN_ENABLED=False
