# Nexvra HRMS frontend - PRODUCTION environment (copy to /etc/nexvra-hrms/frontend.env).
# The Next.js server proxies /api/* to Django on the same host (nginx also routes /api/
# straight to gunicorn; both paths reach the same backend).
BACKEND_URL=http://127.0.0.1:8000
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
