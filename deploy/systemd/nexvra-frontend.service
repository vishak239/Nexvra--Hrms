[Unit]
Description=Nexvra HRMS frontend (Next.js)
After=network.target nexvra-backend.service

[Service]
Type=simple
User=nexvra
Group=nexvra
WorkingDirectory=/opt/nexvra-hrms/frontend
EnvironmentFile=/etc/nexvra-hrms/frontend.env
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
