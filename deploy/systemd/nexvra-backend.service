[Unit]
Description=Nexvra HRMS backend (Django + gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=nexvra
Group=nexvra
WorkingDirectory=/opt/nexvra-hrms/backend
EnvironmentFile=/etc/nexvra-hrms/backend.env
ExecStart=/opt/nexvra-hrms/backend/.venv/bin/gunicorn config.wsgi:application -c /opt/nexvra-hrms/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nexvra-hrms /var/log/nexvra-hrms /var/backups/nexvra-hrms

[Install]
WantedBy=multi-user.target
