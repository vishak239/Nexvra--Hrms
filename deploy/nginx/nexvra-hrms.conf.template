# nginx site for Nexvra HRMS. Replace hrms.example.com with your domain (see docs/deployment.md):
#   sed "s/hrms.example.com/<your-domain>/g" nexvra-hrms.conf.template > /etc/nginx/sites-available/nexvra-hrms
# Certificates: certbot (Let's Encrypt) creates the files referenced below.

# HTTP -> HTTPS (and the ACME challenge for certificate renewal)
server {
    listen 80;
    listen [::]:80;
    server_name hrms.example.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name hrms.example.com;

    ssl_certificate     /etc/letsencrypt/live/hrms.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hrms.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # Security headers for every response (pages and API)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    # Location is used only by this site (office check-in); no camera / microphone.
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()" always;

    server_tokens off;
    client_max_body_size 55m;   # up to 5 message files x 10 MB + form data

    # API straight to gunicorn (Django)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_request_buffering off;  # stream uploads
    }

    # Django static files (only the admin uses them; the admin is off in production by default)
    location /static/ {
        alias /opt/nexvra-hrms/backend/staticfiles/;
        expires 30d;
        access_log off;
    }

    # Private media is NEVER served by nginx; files go through authorised API views only.
    location /private_media/ { return 404; }

    # Everything else: the Next.js app
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
